title: "Benchmarking ECG R-Peak Detectors: Offline and Online Evaluation across Heterogeneous Datasets"
authors:
  - family-names: Costantini
    given-names: Simone
    orcid: "https://orcid.org/0009-0001-5104-6733"
version: 1.0.1
date-released: "2026-10-09"
license: MIT
